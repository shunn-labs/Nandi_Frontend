# Copy to .env.local and fill in what you need. Every value is optional: left
# empty, `npm run dev` talks to local servers and a production build to the
# production hosts (see src/lib/endpoints.js). Placeholders only — never put
# real secrets in this file.

# Brain: REST (/auth, /api/upload) and the /ws/chat, /ws/vision-control, /ws/logs sockets.
# e.g. https://brain.example.com
VITE_API_BASE=

# Vision server signalling for live camera streams.
# e.g. wss://vision.example.com/ws/signal
VITE_VISION_SIGNAL_URL=

# Nandi Audio Server: speech-to-text, text-to-speech, voice mode, live audio streams.
# Settings → Voice → Audio server overrides it per browser.
# e.g. https://audio.example.com
VITE_AUDIO_BASE=

# Google Sign-In OAuth client id.
# e.g. 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
